{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amirulhafiz1132002-code/amrhz-architecture-core/blob/main/schemas/verification-record.schema.json",
  "title": "AMRHZ Verification Record",
  "description": "Records one scoped verification activity. A schema-valid record does not prove that a test ran or that the claim is true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "repository", "ref", "method", "observed_at", "result", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "claim": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "ref": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "environment": { "type": "string" },
    "method": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["PASS", "FAIL", "PARTIAL", "NOT_RUN", "BLOCKED", "UNKNOWN"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference", "description"],
        "properties": {
          "type": { "enum": ["test_output", "ci_run", "commit", "deployment_record", "runtime_observation", "source_inspection", "other"] },
          "reference": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "default": [] },
    "verified_by": { "type": "string" }
  }
}