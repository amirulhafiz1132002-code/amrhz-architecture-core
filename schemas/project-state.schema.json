{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amirulhafiz1132002-code/amrhz-architecture-core/blob/main/schemas/project-state.schema.json",
  "title": "AMRHZ Project State Record",
  "description": "A scoped project or feature state record. Schema validation checks structure and declared transitions, not the truth of claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "scope", "state", "previous_state", "claim", "evidence", "updated_at"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }
      }
    },
    "scope": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["CONCEPT", "PROPOSED", "PLANNED", "DEVELOPMENT", "PARTIAL", "VERIFIED", "LIVE", "BLOCKED", "UNKNOWN"]
    },
    "previous_state": {
      "type": ["string", "null"],
      "enum": ["CONCEPT", "PROPOSED", "PLANNED", "DEVELOPMENT", "PARTIAL", "VERIFIED", "LIVE", "BLOCKED", "UNKNOWN", null]
    },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "default": [] },
    "blocked_by": { "type": "array", "items": { "type": "string" }, "default": [] },
    "updated_at": { "type": "string", "format": "date-time" },
    "owner": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "observed_at", "supports"],
      "properties": {
        "type": {
          "enum": ["source_file", "commit", "test_result", "ci_run", "deployment_record", "runtime_observation", "issue", "human_approval", "other"]
        },
        "reference": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "supports": { "type": "string", "minLength": 1 },
        "result": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "VERIFIED" } }, "required": ["state"] },
      "then": {
        "properties": {
          "project": { "required": ["repository", "ref", "commit_sha"] },
          "evidence": {
            "minItems": 1,
            "contains": {
              "properties": { "type": { "enum": ["test_result", "ci_run", "runtime_observation"] } },
              "required": ["type"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "LIVE" } }, "required": ["state"] },
      "then": {
        "properties": {
          "project": { "required": ["repository", "ref", "commit_sha"] },
          "evidence": {
            "minItems": 1,
            "contains": {
              "properties": { "type": { "const": "deployment_record" } },
              "required": ["type"]
            }
          }
        }
      }
    }
  ]
}
