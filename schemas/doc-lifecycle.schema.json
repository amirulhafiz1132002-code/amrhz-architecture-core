{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amirulhafiz1132002-code/amrhz-architecture-core/blob/main/schemas/doc-lifecycle.schema.json",
  "title": "AMRHZ Documentation Lifecycle Record",
  "description": "Tracks the lifecycle of one exact documentation revision. Structural validity does not authenticate approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "revision_sha", "lifecycle", "previous_lifecycle", "updated_at", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document": { "type": "string", "minLength": 1 },
    "revision_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "lifecycle": { "enum": ["DRAFT", "REVIEWED", "APPROVED", "DEPRECATED"] },
    "previous_lifecycle": { "type": ["string", "null"], "enum": ["DRAFT", "REVIEWED", "APPROVED", "DEPRECATED", null] },
    "updated_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference", "description"],
        "properties": {
          "type": { "enum": ["commit", "pull_request_review", "issue", "other"] },
          "reference": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_login", "actor_id", "decision", "document", "revision_sha", "event_url", "approved_at"],
      "properties": {
        "actor_login": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "integer", "minimum": 1 },
        "decision": { "const": "APPROVE" },
        "document": { "type": "string", "minLength": 1 },
        "revision_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "event_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "APPROVED" } }, "required": ["lifecycle"] },
      "then": { "required": ["approval"] }
    }
  ]
}
